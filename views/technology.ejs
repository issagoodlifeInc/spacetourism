<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#0b0d17">
  <title>Technology | Space tourism</title>
  <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;500;600;700&family=Barlow:wght@400;500&family=Bellefair&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/home.css">
  <script src="/js/site.js" defer></script>
</head>
<body class="page page-technology">
  <%- include('partials/navigation') %>
  <main class="detail-page technology-page">
    <h1 class="section-heading"><span>03</span> Space launch 101</h1>
    <div class="technology-layout" data-switcher="technology">
      <div class="number-tabs" role="tablist" aria-label="Choose a technology">
        <% technology.forEach((item, index) => { %>
          <button class="number-tab <%= index === 0 ? 'is-selected' : '' %>" type="button" role="tab" id="technology-tab-<%= index %>" aria-label="<%= item.name %>" aria-selected="<%= index === 0 %>" aria-controls="technology-panel" tabindex="<%= index === 0 ? '0' : '-1' %>" data-index="<%= index %>"><%= index + 1 %></button>
        <% }) %>
      </div>
      <section class="technology-info" id="technology-panel" role="tabpanel" aria-labelledby="technology-tab-0" tabindex="0" data-panel>
        <p class="eyebrow technology-kicker">The terminology...</p>
        <h2 class="technology-name" data-name><%= technology[0].name %></h2>
        <p class="body-copy technology-description" data-description><%= technology[0].description %></p>
      </section>
      <div class="technology-visual">
        <picture>
          <source media="(max-width: 700px)" srcset="<%= technology[0].images.landscape %>" data-landscape>
          <img src="<%= technology[0].images.portrait %>" alt="<%= technology[0].name %>" data-image>
        </picture>
      </div>
      <script>window.spacePageData = <%- JSON.stringify(technology) %>;</script>
    </div>
  </main>
</body>
</html>